; Run-2855 radiated-elastic electron singles directed at the NPS face.
; The proton arm is generated kinematically but spect_mode=-2 disables its
; detector Monte Carlo, so no HMS coincidence acceptance is imposed.
; Elastic solution at the NPS face center: E'e=7.184157 GeV,
; p_p=4.189740 GeV/c, theta_p=29.294381 deg.

begin parm experiment
  ngen = -1000000
  EXPER%charge = 1.0
  doing_phsp = 0
  doing_kaon = 0
  doing_pion = 0
  doing_decay = 0
  ctau = 780.4
  random_seed = 285517
end parm experiment

begin parm kinematics_main
  Ebeam = 10539.400
  dEbeam = 0.05
  electron_arm = 8
  hadron_arm = 1
  spec%e%P = 7184.157
  spec%e%theta = 16.58000
  spec%p%P = 4189.740
  spec%p%theta = 29.294381
end parm kinematics_main

begin parm target
  targ%A = 1.0
  targ%Z = 1.0
  targ%mass_amu = 1.007276
  targ%mrec_amu = 0.0
  targ%rho = 0.0723
  targ%thick = 723.0
  targ%angle = 0.0
  targ%abundancy = 100.0
  targ%can = 3
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
end parm debug

begin parm e_arm_accept
  SPedge%e%delta%min = -85.0
  SPedge%e%delta%max = 5.0
  SPedge%e%yptar%min = -500.0
  SPedge%e%yptar%max = 500.0
  SPedge%e%xptar%min = -500.0
  SPedge%e%xptar%max = 500.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge%p%delta%min = -100.0
  SPedge%p%delta%max = 100.0
  SPedge%p%yptar%min = -1000.0
  SPedge%p%yptar%max = 1000.0
  SPedge%p%xptar%min = -1000.0
  SPedge%p%xptar%max = 1000.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen%xwid = 0.008868
  gen%ywid = 0.004235
  targ%fr_pattern = 1.0
  targ%fr1 = 0.1
  targ%fr2 = 0.1
  targ%xoffset = 0.0
  targ%yoffset = 0.0
  targ%zoffset = 0.0
end parm beamandtergetinfo

begin parm spect_offset
  spec%e%offset%x = 0.0
  spec%e%offset%y = 0.0
  spec%e%offset%z = 0.0
  spec%e%offset%xptar = 0.0
  spec%e%offset%yptar = 0.0
  spec%p%offset%x = 0.0
  spec%p%offset%y = 0.0
  spec%p%offset%z = 0.0
  spec%p%offset%xptar = 0.0
  spec%p%offset%yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 1
  use_expon = 0
  one_tail = 0
  intcor_mode = 1
  spect_mode = -2
  cuts%Em%min = 0.0
  cuts%Em%max = 0.0
  using_Eloss = 1
  correct_Eloss = 0
  correct_raster = 1
  mc_smear = 1
  deForest_flag = 0
  rad_flag = 0
  extrad_flag = 2
  lambda(1) = 0.0
  lambda(2) = 0.0
  lambda(3) = 0.0
  Nntu = 0
  using_Coulomb = 1
  dE_edge_test = 0.0
  use_offshell_rad = 1
  Egamma_gen_max = 0.0
  drift_to_cal = 950.0
  calo_half_width = 30.75
  calo_half_height = 36.9
  hybrid_export = 1
end parm simulate
