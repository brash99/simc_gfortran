; Hard-bremsstrahlung gamma p -> pi0 p correlated background at the actual
; run-2875 configuration.  The effective upstream radiator is half of the
; 10 cm LH2 target thickness: 0.723 g/cm2 / 63.04 g/cm2 / 2 = 0.00573 X0.

begin parm experiment
  ngen = -100000
  EXPER%charge = 1.0
  doing_pi0phot = 1
  doing_pion = 0
  doing_kaon = 0
  doing_delta = 0
  doing_semi = 0
  doing_rho = 0
  doing_pizero = 0
  pizero_ngamma = 1
  pi0phot_egamma_min = 6500.0
  pi0phot_egamma_max = 10538.0
  pi0phot_costh_min = -0.751
  pi0phot_costh_max = 0.644
  pi0phot_phi_min = 80.0
  pi0phot_phi_max = 100.0
  pi0phot_radlen = 0.00573
  pi0phot_scale_exponent = 7.0
  doing_decay = 0
  random_seed = 2875301
end parm experiment

begin parm kinematics_main
  Ebeam = 10539.41793
  dEbeam = 0.05
  electron_arm = 8
  hadron_arm = 1
  spec%e%P = 7072.0
  spec%e%theta = 16.991
  spec%p%P = 4087.2
  spec%p%theta = 29.86
end parm kinematics_main

begin parm target
  targ%A = 1.0
  targ%Z = 1.0
  targ%mass_amu = 1.007276
  targ%mrec_amu = 0.0
  targ%rho = 0.0723
  targ%thick = 723.0
  targ%angle = 0.0
  targ%abundancy = 100.0
  targ%can = 3
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
end parm debug

begin parm e_arm_accept
  SPedge%e%delta%min = -15.0
  SPedge%e%delta%max = 15.0
  SPedge%e%yptar%min = -500.0
  SPedge%e%yptar%max = 500.0
  SPedge%e%xptar%min = -500.0
  SPedge%e%xptar%max = 500.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge%p%delta%min = -15.0
  SPedge%p%delta%max = 15.0
  SPedge%p%yptar%min = -90.0
  SPedge%p%yptar%max = 90.0
  SPedge%p%xptar%min = -50.0
  SPedge%p%xptar%max = 50.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen%xwid = 0.008868
  gen%ywid = 0.004235
  targ%fr_pattern = 1.0
  targ%fr1 = 0.1
  targ%fr2 = 0.1
  targ%xoffset = 0.0
  targ%yoffset = 0.0
  targ%zoffset = 0.0
end parm beamandtergetinfo

begin parm spect_offset
  spec%e%offset%x = 0.0
  spec%e%offset%y = 0.0
  spec%e%offset%z = 0.0
  spec%e%offset%xptar = 0.0
  spec%e%offset%yptar = 0.0
  spec%p%offset%x = 0.0
  spec%p%offset%y = 0.0
  spec%p%offset%z = 0.0
  spec%p%offset%xptar = 0.0
  spec%p%offset%yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 0
  spect_mode = 0
  cuts%Em%min = 0.0
  cuts%Em%max = 0.0
  using_Eloss = 1
  correct_Eloss = 0
  correct_raster = 1
  mc_smear = 1
  Nntu = 1
  using_Coulomb = 0
  using_tgt_field = 0
  drift_to_cal = 950.0
  calo_half_width = 30.75
  calo_half_height = 36.9
  hybrid_export = 1
end parm simulate
