; Run-2875 elastic calibration closure sample for SIMC -> NPS GEANT4.
; Hardware anchors: Ebeam=10.53941793 GeV, HMS=4.0872 GeV/c at 29.86 deg.
; Actual replay geometry: NPS central angle=16.58 deg and distance=9.5 m.
; The 16.991-deg elastic-ray angle is not the NPS mechanical central angle.
; The NPS 2023 cryotarget is modeled as 10 cm LH2 (723 mg/cm2).

begin parm experiment
  ngen = -1000000
  EXPER%charge = 1.0
  doing_phsp = 0
  doing_kaon = 0
  doing_pion = 0
  doing_decay = 0
  ctau = 780.4
  random_seed = 2875001
end parm experiment

begin parm kinematics_main
  Ebeam = 10539.41793
  dEbeam = 0.05
  electron_arm = 8
  hadron_arm = 1
  spec%e%P = 7072.0
  spec%e%theta = 16.58
  spec%p%P = 4087.2
  spec%p%theta = 29.86
end parm kinematics_main

begin parm target
  targ%A = 1.0
  targ%Z = 1.0
  targ%mass_amu = 1.007276
  targ%mrec_amu = 0.0
  targ%rho = 0.0723
  targ%thick = 723.0
  targ%angle = 0.0
  targ%abundancy = 100.0
  targ%can = 3
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
end parm debug

begin parm e_arm_accept
  SPedge%e%delta%min = -15.0
  SPedge%e%delta%max = 15.0
  SPedge%e%yptar%min = -500.0
  SPedge%e%yptar%max = 500.0
  SPedge%e%xptar%min = -500.0
  SPedge%e%xptar%max = 500.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge%p%delta%min = -15.0
  SPedge%p%delta%max = 15.0
  SPedge%p%yptar%min = -90.0
  SPedge%p%yptar%max = 90.0
  SPedge%p%xptar%min = -50.0
  SPedge%p%xptar%max = 50.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen%xwid = 0.008868
  gen%ywid = 0.004235
  targ%fr_pattern = 1.0
  targ%fr1 = 0.1
  targ%fr2 = 0.1
  targ%xoffset = 0.0
  targ%yoffset = 0.0
  targ%zoffset = 0.0
end parm beamandtergetinfo

begin parm spect_offset
  spec%e%offset%x = 0.0
  spec%e%offset%y = 0.0
  spec%e%offset%z = 0.0
  spec%e%offset%xptar = 0.0
  spec%e%offset%yptar = 0.0
  spec%p%offset%x = 0.0
  spec%p%offset%y = 0.0
  spec%p%offset%z = 0.0
  spec%p%offset%xptar = 0.0
  spec%p%offset%yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 1
  use_expon = 0
  one_tail = 0
  intcor_mode = 1
  spect_mode = 0
  cuts%Em%min = 0.0
  cuts%Em%max = 0.0
  using_Eloss = 1
  correct_Eloss = 0
  correct_raster = 1
  mc_smear = 1
  deForest_flag = 0
  rad_flag = 0
  extrad_flag = 2
  lambda(1) = 0.0
  lambda(2) = 0.0
  lambda(3) = 0.0
  Nntu = 1
  using_Coulomb = 1
  dE_edge_test = 0.0
  use_offshell_rad = 1
  Egamma_gen_max = 0.0
  drift_to_cal = 950.0
  calo_half_width = 32.4
  calo_half_height = 38.88
  hybrid_export = 1
end parm simulate
