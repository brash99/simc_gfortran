; Fixed-attempt smoke test for the exploratory GEp-IV Hall C reboot setting.
; This deck checks execution and geometric acceptance; it is not a
; production-normalization or physics-validation configuration.

begin parm experiment
  ngen = -1000000               ; negative value fixes the number of trials
  EXPER%charge = 1.0            ; total charge (mC)
  doing_phsp = 0
  doing_kaon = 0
  doing_pion = 0                ; all reaction flags false selects (e,e'p)
  doing_decay = 0
  ctau = 780.4
  random_seed = 110011
end parm experiment

begin parm kinematics_main
  Ebeam = 10700.0               ; MeV
  dEbeam = 0.05                 ; percent
  electron_arm = 8              ; beam-left calorimeter (NPS)
  hadron_arm = 1                ; HMS
  spec%e%P = 4838.0             ; MeV/c
  spec%e%theta = 26.651         ; degrees
  spec%p%P = 6735.0             ; MeV/c
  spec%p%theta = 18.797         ; degrees
end parm kinematics_main

begin parm target
  targ%A = 1.0
  targ%Z = 1.0
  targ%mass_amu = 1.007276
  targ%mrec_amu = 0.0
  targ%rho = 0.0723             ; g/cm^3
  targ%thick = 2169.0           ; mg/cm^2, nominal 30 cm LH2
  targ%angle = 0.0
  targ%abundancy = 100.0
  targ%can = 3
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
end parm debug

begin parm e_arm_accept
  SPedge%e%delta%min = -15.0
  SPedge%e%delta%max = 15.0
  SPedge%e%yptar%min = -500.0
  SPedge%e%yptar%max = 500.0
  SPedge%e%xptar%min = -500.0
  SPedge%e%xptar%max = 500.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge%p%delta%min = -15.0
  SPedge%p%delta%max = 15.0
  SPedge%p%yptar%min = -90.0
  SPedge%p%yptar%max = 90.0
  SPedge%p%xptar%min = -50.0
  SPedge%p%xptar%max = 50.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen%xwid = 0.008868
  gen%ywid = 0.004235
  targ%fr_pattern = 1.0
  targ%fr1 = 0.1
  targ%fr2 = 0.1
  targ%xoffset = 0.0
  targ%yoffset = 0.0
  targ%zoffset = 0.0
end parm beamandtergetinfo

begin parm spect_offset
  spec%e%offset%x = 0.0
  spec%e%offset%y = 0.0
  spec%e%offset%z = 0.0
  spec%e%offset%xptar = 0.0
  spec%e%offset%yptar = 0.0
  spec%p%offset%x = 0.0
  spec%p%offset%y = 0.0
  spec%p%offset%z = 0.0
  spec%p%offset%xptar = 0.0
  spec%p%offset%yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 1
  use_expon = 0
  one_tail = 0
  intcor_mode = 1
  spect_mode = 0
  cuts%Em%min = 0.0
  cuts%Em%max = 0.0
  using_Eloss = 1
  correct_Eloss = 0
  correct_raster = 1
  mc_smear = 1
  deForest_flag = 0
  rad_flag = 0
  extrad_flag = 2
  lambda(1) = 0.0
  lambda(2) = 0.0
  lambda(3) = 0.0
  Nntu = 0                     ; diagnostic text output only for smoke test
  using_Coulomb = 1
  dE_edge_test = 0.0
  use_offshell_rad = 1
  Egamma_gen_max = 0.0
  drift_to_cal = 300.0         ; cm
  calo_half_width = 30.75      ; cm, 30 NPS blocks at 2.05 cm pitch
  calo_half_height = 36.9      ; cm, 36 NPS blocks at 2.05 cm pitch
end parm simulate
